npm install --save-dev --save-exact @biomejs/biome
npx @biomejs/biome init
vi biome.json 
npx @biomejs/biome check src/LandingPage.jsx


modifiche a biome.json:
    "indentStyle": "space",
    "indentWidth": 4,
    "lineWidth": 200

# limitare gli errori da controllare:
biome lint  --only=style/useTemplate --only=style/useConst src/VerifyMark.jsx
biome lint --write  --unsafe --only=style/useTemplate --only=style/useConst src/VerifyMark.jsx
